---
// Fonts are self-hosted and preloaded, as on northbound.sh. English only.
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import soraLatinExt from '@fontsource-variable/sora/files/sora-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoLatinExt from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-400-normal.woff2?url';
import { NB_URL, LOGO_L, LOGO_R } from '../components/shared.jsx';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://oss.northbound.sh');
const canonical = new URL(Astro.url.pathname, site).href;

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (family: string, weight: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fontFaces = [
  face('Sora', '100 800', soraLatin, LATIN),
  face('Sora', '100 800', soraLatinExt, LATIN_EXT),
  face('IBM Plex Mono', '400', monoLatin, LATIN),
  face('IBM Plex Mono', '400', monoLatinExt, LATIN_EXT),
].join('\n');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="darkreader-lock">
<meta name="color-scheme" content="only dark">
<style is:inline>:root{color-scheme:only dark}</style>
<script is:inline define:vars={{ nb: NB_URL }}>
// Arriving from northbound.sh: the page stays black with the oss mark for a moment,
// then the mark fades and the page plays its entrance (see .arrive in oss.css).
try {
  var d = document.documentElement;
  var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still && document.referrer.indexOf(nb) === 0) {
    d.classList.add('nb-arrive');
    setTimeout(function () { d.classList.add('nb-arrived'); }, 950);
  }
} catch (e) {}
</script>
<link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin fetchpriority="low">
<style is:inline set:html={fontFaces}></style>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#000000">
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="northbound oss">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
</head>
<body>
<div class="arrive" aria-hidden="true">
  <svg viewBox="0 0 256 256" width="72" height="72">
    <path class="sh1" d={LOGO_L} fill="#E11D48"></path>
    <path class="sh2" d={LOGO_R} fill="#F8FAFC"></path>
  </svg>
  <span class="awm">northbound<span class="wmo">oss</span></span>
</div>
<slot />
</body>
</html>

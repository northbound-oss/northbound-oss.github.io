---
// Fonts are self-hosted and preloaded, as on northbound.sh. They sit in public/fonts at fixed
// URLs that public/intro.js (the project sites' intro) uses too, so it finds them in the cache.
// The language works as on northbound.sh: `/` follows the system, `/ru/` is always Russian, `/en/` always English.
import { NB_URL, LOGO_L, LOGO_R } from '../components/shared.jsx';

interface Props {
  /** 'auto' = the language follows the system; 'ru' / 'en' = the /ru or /en URL */
  lang: 'auto' | 'ru' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://oss.northbound.sh');
const href = (l: string) => new URL(l === 'ru' ? '/ru/' : '/', site).href;
// /en/ repeats the English of `/`: its canonical is `/`
const canonical = href(lang);

const F = '/fonts/';
const soraLatin = F + 'sora-latin-wght-normal.woff2';
const soraLatinExt = F + 'sora-latin-ext-wght-normal.woff2';
const onestCyr = F + 'onest-cyrillic-wght-normal.woff2';
const monoLatin = F + 'ibm-plex-mono-latin-400-normal.woff2';
const monoLatinExt = F + 'ibm-plex-mono-latin-ext-400-normal.woff2';
const monoCyr = F + 'ibm-plex-mono-cyrillic-400-normal.woff2';

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const face = (family: string, weight: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fontFaces = [
  face('Sora', '100 800', soraLatin, LATIN),
  face('Sora', '100 800', soraLatinExt, LATIN_EXT),
  face('Onest', '100 800', onestCyr, CYR),
  face('IBM Plex Mono', '400', monoLatin, LATIN),
  face('IBM Plex Mono', '400', monoLatinExt, LATIN_EXT),
  face('IBM Plex Mono', '400', monoCyr, CYR),
].join('\n');
const cyrPreloads = [onestCyr, monoCyr];
---
<!doctype html>
<html lang={lang === 'ru' ? 'ru' : 'en'} data-lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="darkreader-lock">
<meta name="color-scheme" content="only dark">
<style is:inline>:root{color-scheme:only dark}</style>
<script is:inline define:vars={{ nb: NB_URL, cyrPreloads }}>
// Runs before anything paints. The language: on `/` CIS system languages get Russian,
// the same rule as on northbound.sh. That page is rendered in English, so for Russian it
// stays hidden (nb-wait) until OSS.jsx has switched it; its entrance plays from there.
var d = document.documentElement, lang = d.getAttribute('data-lang');
if (lang === 'auto') {
  lang = 'en';
  try {
    var cis = ['ru', 'be', 'kk', 'ky', 'tg', 'uz', 'hy', 'az', 'tk', 'mo', 'tt', 'ba', 'cv', 'sah', 'ce', 'os'];
    var isCis = function (l) { l = String(l || '').toLowerCase(); return cis.indexOf(l.split(/[-_]/)[0]) >= 0 || /^ro[-_]md/.test(l); };
    var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
    // Russian if the browser's own interface runs in a CIS language (a Russian system often
    // still lists English first), or if the first preferred language the site has — English or
    // a CIS one — is a CIS one. Russian merely somewhere in the list (a keyboard on an English
    // system) does not count.
    var first = Array.prototype.filter.call(list, function (l) { return isCis(l) || /^en(?:[-_]|$)/i.test(l); })[0];
    if (isCis(Intl.DateTimeFormat().resolvedOptions().locale) || isCis(first)) lang = 'ru';
  } catch (e) {}
  if (lang === 'ru') {
    d.classList.add('nb-wait');
    cyrPreloads.forEach(function (u) {
      var k = document.createElement('link');
      k.rel = 'preload'; k.as = 'font'; k.type = 'font/woff2'; k.crossOrigin = ''; k.href = u;
      document.head.appendChild(k);
    });
  }
}
window.__nbLang = lang;
d.lang = lang;
// Arriving from northbound.sh or back from a project's site (a page of this origin other than
// the start pages): the page stays black with the oss mark for a moment, then the mark fades
// and the page plays its entrance (see .arrive in oss.css).
try {
  var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var r = document.referrer, own = location.origin + '/';
  var fromProject = r.indexOf(own) === 0 && !/^((ru|en)\/)?([?#].*)?$/.test(r.slice(own.length));
  if (!still && (r.indexOf(nb) === 0 || fromProject)) {
    d.classList.add('nb-arrive');
    setTimeout(function () { d.classList.add('nb-arrived'); }, 950);
  }
} catch (e) {}
</script>
<link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin>
<!-- the project sites' intro, ready for when a project tile is opened -->
<link rel="prefetch" href="/intro.js">
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin fetchpriority="low">
{lang === 'ru' && cyrPreloads.map((u) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin>)}
<style is:inline set:html={fontFaces}></style>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#000000">
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href={href('en')}>
<link rel="alternate" hreflang="ru" href={href('ru')}>
<link rel="alternate" hreflang="x-default" href={href('en')}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="northbound oss">
<meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
</head>
<body>
<div class="arrive" aria-hidden="true">
  <svg viewBox="0 0 256 256" width="72" height="72">
    <path class="sh1" d={LOGO_L} fill="#E11D48"></path>
    <path class="sh2" d={LOGO_R} fill="#F8FAFC"></path>
  </svg>
  <span class="awm">northbound<span class="wmo">oss</span></span>
</div>
<slot />
</body>
</html>
